{
  "name": "quick-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "A fast desktop application launcher for Windows and macOS.",
  "author": "xxxwonking",
  "repository": "https://github.com/xxxwonking/quick-launcher",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "pnpm run electron:install",
    "electron:install": "install-electron --no",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "pnpm run test:node && pnpm run test:renderer",
    "test:node": "vitest run --config vitest.config.ts",
    "test:renderer": "vitest run --config vitest.renderer.config.ts",
    "test:watch:node": "vitest --config vitest.config.ts",
    "test:watch:renderer": "vitest --config vitest.renderer.config.ts",
    "test:e2e": "pnpm build && playwright test",
    "dist:mac": "pnpm build && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:mac:universal": "pnpm build && electron-builder --mac dmg zip --universal --publish never",
    "dist:win": "pnpm build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@reactour/tour": "3.8.0",
    "lucide-react": "1.33.0",
    "pinyin-pro": "3.29.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.0",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.1",
    "globals": "17.11.0",
    "jsdom": "27.1.0",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.18.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron-winstaller",
      "esbuild"
    ]
  }
}
